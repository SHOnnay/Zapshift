# Firebase Config
VITE_apiKey=your_firebase_api_key
VITE_authDomain=your_project.firebaseapp.com
VITE_projectId=your_project_id
VITE_storageBucket=your_project.firebasestorage.app
VITE_messagingSenderId=your_messaging_sender_id
VITE_appId=your_app_id

# ImgBB Image Upload Key
VITE_image_host_key=your_imgbb_api_key

# Backend API URL (set this to your Vercel server URL after deploying server)
VITE_API_URL=https://your-server.vercel.app
